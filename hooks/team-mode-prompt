#!/usr/bin/env bash
# Dream Team — UserPromptSubmit hook.
#
# Six things the harness can tell the model deterministically, which prose
# at the top of a long skill cannot guarantee:
#
#   <TEAM-LEGACY-STATE>  the project's run state is still in the directory
#                        teams before 4.0.0 used; /team must not start a run.
#                        Emitted on every prompt, slash commands included,
#                        while that directory exists.
#   <TEAM-MODE-STALE>    the marker names a run whose status.md is missing;
#                        the marker is to be deleted, the message is a
#                        standalone request.
#   <TEAM-MODE-CLOSED>   the marker names a run whose status.md is closed (its
#                        first line contains "[DONE" or "Complete —"); the
#                        message is feedback on that run and the team skill's
#                        references/follow-up.md says what to do with it.
#                        Never on a slash command.
#   <TEAM-MODE-ACTIVE>   a run is open; the message belongs to it. Never on a
#                        slash command, which is an explicit instruction.
#   <TEAM-INBOX-DUE>     the learnings inbox is due; emitted only on the prompt
#                        that starts a run.
#   <TEAM-KNOWLEDGE-SCAFFOLD>  the knowledge files were written on an empty
#                        project and the project now has content; emitted only
#                        on the prompt that starts a run.
#
# This survives a model switch, a long pause, a compaction and a restart,
# because the harness runs this hook on every submitted prompt. Exit 0 with no
# output = nothing to say. The hook must never break a session, so every
# failure path is silent.

set -uo pipefail

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
TRACKING="${PROJECT_DIR}/.dream-team-tracking"
MARKER="${TRACKING}/.team-mode"
LEGACY="${PROJECT_DIR}/.claude-tracking"

payload="$(cat 2>/dev/null || true)"

# A slash command is an explicit instruction to the harness — never override it.
# Leading whitespace, raw or JSON-escaped (\n, \t, \r), does not make it a prompt.
slash=0
if printf '%s' "$payload" | grep -qE '"prompt"[[:space:]]*:[[:space:]]*"([[:space:]]|\\[ntr])*/'; then
  slash=1
fi

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

read_field() {
  sed -n "s/^$1=//p" "$MARKER" 2>/dev/null | head -1 | tr -d '\r'
}

context=""

if [ -d "$LEGACY" ]; then
  context="${context}<TEAM-LEGACY-STATE>\n"
  context="${context}This project's run state is still in the legacy directory .claude-tracking/, which teams before 4.0.0 used. /team starts no run and resumes none until it is moved: run /team-setup, which shows a dry run of tools/migrate-tracking.sh and moves the state when its dry run is clean. /team stop and /team status still work. If a TEAM-MODE-ACTIVE block follows, do not continue that run: ask for /team stop, then /team-setup. Say this in one line when the user asks for a run; do not improvise a workaround.\n"
  context="${context}</TEAM-LEGACY-STATE>\n"
fi

# A new run reads the learnings index whole, so the moment to say that the
# inbox is due is the prompt that starts one: "/team <task>", never stop,
# status or resume, and never a plain message. The check prints the reasons
# and exits 1 when due; 0 and 2 (clean, or limits unreadable) stay silent.
# Skipped while the legacy directory exists: no run can start then.
#
# The same prompt is where scaffold knowledge is reported: the files were
# written on an empty project (checks/verify-knowledge-scaffold.sh reads the
# banner) and the project now has content, so a run would build on files
# nothing verified. Exit 1 only: a scaffold on a still-empty project (exit 3)
# is the preflight's to mention, and the hook speaks only for the state change
# the orchestrator would otherwise not see.
TEAM_ROOT="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
if [ ! -d "$LEGACY" ] && printf '%s' "$payload" | grep -qE '"prompt"[[:space:]]*:[[:space:]]*"([[:space:]]|\\[ntr])*/team[[:space:]]' \
   && ! printf '%s' "$payload" | grep -qE '"prompt"[[:space:]]*:[[:space:]]*"([[:space:]]|\\[ntr])*/team[[:space:]]+(stop|status|resume)'; then
  # Where the knowledge lives is the resolver's answer, run from the project root; when it
  # fails or is missing the hook falls back to the directory it read before it existed.
  resolve_dir() { # project|operative FALLBACK -> an absolute directory
    local d
    if [ -f "$TEAM_ROOT/tools/knowledge-dir.sh" ]; then
      d="$(cd "$PROJECT_DIR" 2>/dev/null && bash "$TEAM_ROOT/tools/knowledge-dir.sh" "$1" 2>/dev/null)" || d=""
    fi
    if [ -n "${d:-}" ]; then printf "%s" "$PROJECT_DIR/$d"; else printf "%s" "$2"; fi
  }
  if [ -n "$TEAM_ROOT" ] && [ -f "$TEAM_ROOT/checks/verify-learnings-inbox.sh" ]; then
    inbox="$(bash "$TEAM_ROOT/checks/verify-learnings-inbox.sh" "$(resolve_dir operative "$TEAM_ROOT/knowledge")" 2>/dev/null)"; rc=$?
    if [ "$rc" -eq 1 ]; then
      summary="$(printf '%s\n' "$inbox" | head -1 | sed 's/^learnings inbox: //')"
      summary="$(escape_for_json "$summary")"
      context="${context}<TEAM-INBOX-DUE>\n"
      context="${context}The learnings inbox is due: ${summary}. In Step 0, before any research, offer the refresh as .claude/skills/team/references/knowledge-refresh.md describes (one AskUserQuestion: refresh now / continue), then record \\\"Inbox due: offered YYYY-MM-DD — <answer>\\\" in status.md → Process notes. Never block the run on it.\n"
      context="${context}</TEAM-INBOX-DUE>\n"
    fi
  fi
  if [ -n "$TEAM_ROOT" ] && [ -f "$TEAM_ROOT/checks/verify-knowledge-scaffold.sh" ]; then
    scaffold="$(bash "$TEAM_ROOT/checks/verify-knowledge-scaffold.sh" "$PROJECT_DIR" "$(resolve_dir project "$TEAM_ROOT/knowledge")" 2>/dev/null)"; rc=$?
    if [ "$rc" -eq 1 ]; then
      written="$(printf '%s\n' "$scaffold" | sed -n 's/^knowledge: scaffold //p' | head -1)"
      written="$(escape_for_json "$written")"
      context="${context}<TEAM-KNOWLEDGE-SCAFFOLD>\n"
      context="${context}The knowledge files are scaffolds written on an empty project on ${written}, and the project now has content. In Step 0 offer the refresh as .claude/skills/team/references/knowledge-refresh.md describes (one AskUserQuestion: refresh now / continue), then record \\\"Scaffold knowledge: offered YYYY-MM-DD — <answer>\\\" in status.md → Process notes. Never block the run on it.\n"
      context="${context}</TEAM-KNOWLEDGE-SCAFFOLD>\n"
    fi
  fi
fi

if [ "$slash" -eq 0 ] && [ -f "$MARKER" ]; then
  context_id="$(read_field context_id)"
  workflow="$(read_field workflow)"
  phase="$(read_field phase)"
  [ -n "$workflow" ] || workflow="unknown"
  [ -n "$phase" ] || phase="unknown"

  if [ -n "$context_id" ]; then
    status_file="${TRACKING}/${context_id}/status.md"
    state=""
    if [ ! -f "$status_file" ]; then
      state="missing"
    else
      # A run is closed when its first line carries [DONE (4.x) or Complete —
      # (older prose closings); the status.md decides, not the marker's state line.
      first="$(head -1 "$status_file" 2>/dev/null | tr -d '\r')"
      if printf '%s' "$first" | grep -qF '[DONE' || printf '%s' "$first" | grep -qF 'Complete —'; then
        state="closed"
      fi
    fi
    cid="$(escape_for_json "$context_id")"
    if [ "$state" = "missing" ]; then
      context="${context}<TEAM-MODE-STALE>\n"
      context="${context}The marker .dream-team-tracking/.team-mode names run ${cid}, whose status.md is missing. The run is not open. Delete the marker with the shell command rm -f .dream-team-tracking/.team-mode, say so in one line, and treat the user's message as a standalone request.\n"
      context="${context}</TEAM-MODE-STALE>\n"
    elif [ "$state" = "closed" ]; then
      closed_on="$(read_field closed)";      [ -n "$closed_on" ]   || closed_on="unknown"
      result="$(read_field result)";         [ -n "$result" ]      || result="unknown"
      verify_open="$(read_field verify_open)"; [ -n "$verify_open" ] || verify_open="0"
      parent="$(read_field parent)"
      closed_on="$(escape_for_json "$closed_on")"; result="$(escape_for_json "$result")"
      verify_open="$(escape_for_json "$verify_open")"
      parent_clause=""
      [ -z "$parent" ] || parent_clause="; parent $(escape_for_json "$parent")"
      context="${context}<TEAM-MODE-CLOSED>\n"
      context="${context}Run ${cid} closed ${closed_on} with result ${result}; ${verify_open} Verify by hand lines open${parent_clause}. The run is not open, but this message arrives in its project right after it: treat it as feedback on that run, not as a standalone request.\n"
      context="${context}1. If the team skill is not already loaded in this session, invoke it now (Skill tool, name \\\"team\\\"). 2. Read .dream-team-tracking/${cid}/status.md and .claude/skills/team/references/follow-up.md, and follow follow-up.md: it says which messages update the closed run, which open a linked run, which start a new task, and which are not about the run at all. 3. Stay in the orchestrator role. If the marker lacks a state=closed line, rewrite it to the closed form the team skill describes before anything else.\n"
      context="${context}Handle directly, without the workflow: a request to stop team mode (delete .dream-team-tracking/.team-mode, confirm in one line), and questions about the run's own status.\n"
      context="${context}</TEAM-MODE-CLOSED>"
    else
      wf="$(escape_for_json "$workflow")"
      ph="$(escape_for_json "$phase")"
      context="${context}<TEAM-MODE-ACTIVE>\n"
      context="${context}Dream Team mode is ON for this project. Run: ${cid}. Workflow: ${wf}. Last recorded phase: ${ph}.\n"
      context="${context}Treat the user's message as input to that run, not as a standalone request.\n"
      context="${context}1. If the team skill is not already loaded in this session, invoke it now (Skill tool, name \\\"team\\\") and read .dream-team-tracking/${cid}/status.md before answering.\n"
      context="${context}2. Continue the existing run from its first unchecked phase. Never restart it and never open a second run in parallel.\n"
      context="${context}3. Stay in the orchestrator role: no production code, no tests, no build or test commands of your own — those belong to the Developer, Tester and Reviewer subagents.\n"
      context="${context}Handle directly, without the workflow: a request to stop or pause team mode (delete .dream-team-tracking/.team-mode, confirm in one line), and questions about the run's own status.\n"
      context="${context}</TEAM-MODE-ACTIVE>"
    fi
  fi
fi

[ -n "$context" ] || exit 0

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "UserPromptSubmit",\n    "additionalContext": "%s"\n  },\n  "suppressOutput": true\n}\n' "$context"
