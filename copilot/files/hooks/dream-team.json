{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash .github/dream-team/hooks/session-start",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/dream-team/hooks/session-start.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Bash",
        "bash": "[ ! -f .github/dream-team/hooks/guard-command ] || bash .github/dream-team/hooks/guard-command || true",
        "powershell": "if (Test-Path .github/dream-team/hooks/guard-command.ps1) { powershell -NoProfile -ExecutionPolicy Bypass -File .github/dream-team/hooks/guard-command.ps1 2>$null }; exit 0",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
