# hooks/team-mode-prompt and hooks/guard-command are bash scripts and
# hooks/run-hook.cmd is a cmd/sh polyglot: a CRLF checkout breaks them, and
# with them sticky team mode and the guard. Pin LF
# so a clone matches what was committed, on machines with core.autocrlf=true.
# tools/migrate-tracking.sh is run through bash by Claude Code the same way
# and gets the same pin.
#
# Scoped to those files on purpose: a blanket `* eol=lf` would impose line
# endings on every other file of the repository.
hooks/run-hook.cmd text eol=lf
hooks/team-mode-prompt text eol=lf
hooks/guard-command text eol=lf
tools/migrate-tracking.sh text eol=lf
tools/normalize-status.sh text eol=lf
tools/collect-amendments.sh text eol=lf
# copilot/ builds the GitHub Copilot edition; its scripts and awk programs run
# through bash and awk, which a CRLF checkout breaks the same way.
copilot/*.sh text eol=lf
copilot/lib/*.awk text eol=lf
copilot/files/dream-team/hooks/session-start text eol=lf
copilot/files/dream-team/hooks/guard-command text eol=lf
