# This repository's own ignore file. The Claude Code plugin takes no part in a
# project's version control: /team-setup hides a project's .claude/knowledge/
# and .dream-team-tracking/ through .git/info/exclude, which needs no commit
# (see gitExclude in team-manifest.json).
#
# The Copilot edition installs this file as .github/dream-team/.gitignore,
# where `knowledge/` is read relative to that directory and hides the
# edition's knowledge.
knowledge/
temp/
docs/

# Left from the in-project install, where a project's settings sat beside the
# team; inert in this repository and in the Copilot edition.
settings.json
settings.local.json

# OS noise
Thumbs.db
desktop.ini
.DS_Store
