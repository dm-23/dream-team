# This file travels with the team. In a project it lands at .claude/.gitignore,
# where every pattern below is read relative to .claude/ — so `knowledge/` hides
# .claude/knowledge/ without the project having to touch its own ignore file.
#
# .dream-team-tracking/ lives at the project root, outside this directory.
# /team-setup hides it through .git/info/exclude, which needs no commit, and
# touches the project's own .gitignore only to replace a legacy line it already
# carries (see gitExclude in team-manifest.json). Neither layer is ever committed.
knowledge/
temp/
docs/

# The project's own hook wiring and permissions live beside the team in a
# clone-in-place install and are never the team's.
settings.json
settings.local.json

# OS noise
Thumbs.db
desktop.ini
.DS_Store
